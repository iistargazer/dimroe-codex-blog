{
  "name": "site-player",
  "version": "1.0.0",
  "description": "Floating ambient music player for Dimroe's Codex",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js",
    "./package.json": "./package.json"
  },
  "quartz": {
    "name": "site-player",
    "displayName": "Site Player",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 70,
    "defaultEnabled": true,
    "defaultOptions": {
      "playlist": "/static/playlist.json"
    },
    "components": {
      "SitePlayer": {
        "displayName": "Site Player",
        "defaultPosition": "footer",
        "defaultPriority": 70
      }
    },
    "optionSchema": {
      "playlist": {
        "type": "string"
      }
    }
  }
}
